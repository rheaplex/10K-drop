{
  "name": "10k-drop",
  "version": "1.0.0",
  "description": "A 10K drop.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dirs": "node script/directory-structure",
    "fonts": "node script/reduce-fonts",
    "html": "node script/render-html",
    "svg": "node script/render-svg",
    "js": "npx webpack --output-path ./dist/animation/js/ ./src/js/animation-html",
    "png": "node script/render-png",
    "thumbnail": "node script/thumbnail",
    "metadata": "node script/render-metadata",
    "montage": "feh --index --no-screen-clip --limit-width 2000 --thumb-height 180 --thumb-width 320 --fullscreen --sort mtime --reverse dist/image/*.png",
    "all": "npm run dirs && npm run js && npm run fonts && npm run html && npm run svg && npm run png && npm run thumbnail && npm run metadata"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rheaplex/10K-drop.git"
  },
  "keywords": [
    "art",
    "nft",
    "drop"
  ],
  "author": "Rhea Myers",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/rheaplex/10K-drop/issues"
  },
  "homepage": "https://github.com/rheaplex/10K-drop#README.md",
  "dependencies": {
    "canvas": "^2.11.2",
    "csv": "^6.3.9",
    "dommatrix": "^0.0.3-e",
    "matter-js": "^0.20.0",
    "pathseg": "^1.2.1",
    "poly-decomp": "^0.3.0",
    "sharp": "^0.33.4",
    "snapsvg": "^0.5.1",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
